      "item": [
        {
          "name": "Register customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ST10472017",
                  "// Postman, 2026. Test examples in Postman. [Online]",
                  "// Available at: https://learning.postman.com/docs/tests-and-scripts/write-scripts/test-examples/",
                  "// [Accessed 9 November 2026].",
                  "",
                  "pm.collectionVariables.set(\"customerEmail\", `student_${Date.now()}@campus.ac.za`);",
                  "pm.collectionVariables.set(\"staffEmail\", `barista_${Date.now()}@coffeenchill.ac.za`);",
                  "if (!pm.collectionVariables.get(\"adminEmail\")) {",
                  "    pm.collectionVariables.set(\"adminEmail\", \"admin@coffeenchill.ac.za\");",
                  "    pm.collectionVariables.set(\"adminPassword\", \"Admin#12345\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const user = pm.response.json();",
                  "pm.test(\"Registered as Customer\", () => pm.expect(user.role).to.eql(\"Customer\"));",
                  "pm.test(\"Password hash is never returned\", () => {",
                  "    pm.expect(user).to.not.have.property(\"passwordHash\");",
                  "    pm.expect(JSON.stringify(user)).to.not.include(\"$2\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"Student#2026\",\n  \"fullName\": \"Jane Smith\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
