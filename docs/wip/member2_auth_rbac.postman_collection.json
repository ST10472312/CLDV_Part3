        {
          "name": "Login as the customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"JWT has three parts\", () => pm.expect(body.token.split(\".\")).to.have.lengthOf(3));",
                  "pm.test(\"Role is Customer\", () => pm.expect(body.role).to.eql(\"Customer\"));",
                  "",
                  "// Decode the payload to prove the expiry and role claims live inside the token.",
                  "const b64 = body.token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
                  "const payload = JSON.parse(atob(b64));",
                  "pm.test(\"Token expires in the future\", () => pm.expect(payload.exp * 1000).to.be.above(Date.now()));",
                  "pm.test(\"Role claim present\", () => {",
                  "    const roleKey = Object.keys(payload).find(k => k.toLowerCase().endsWith(\"role\"));",
                  "    pm.expect(payload[roleKey]).to.eql(\"Customer\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"customerToken\", body.token);",
                  "pm.collectionVariables.set(\"token\", body.token);"
                ]
              }
            }
          ],
